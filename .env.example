NEXT_PUBLIC_APP_URL=http://127.0.0.1:43131
AUTH_SECRET=replace-with-a-long-random-string

# Hosted Postgres / Supabase (omit to use local PGlite)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/allycircle

# Google login (People/email scopes only)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional separate Calendar OAuth client. If omitted, Calendar reuses GOOGLE_CLIENT_ID.
# Enable Calendar API + Google Meet on the Google Cloud project.
# Redirect: {NEXT_PUBLIC_APP_URL}/api/calendar/google/callback
# Also add {NEXT_PUBLIC_APP_URL}/api/auth/callback/google for login.
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=

# Transactional email via Resend
# RESEND_API_KEY=
# EMAIL_FROM=AllyCircle <noreply@yourdomain.com>

# Protect unauthenticated job ticks in production (Vercel Cron sends this automatically)
# CRON_SECRET=

# Extra Better Auth origins, comma-separated
# AUTH_TRUSTED_ORIGINS=https://your-domain.com

# Never commit real values. Do not paste secrets into chat.
