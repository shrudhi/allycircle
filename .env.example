NEXT_PUBLIC_APP_URL=http://127.0.0.1:43131
AUTH_SECRET=replace-with-a-long-random-string

# Optional: hosted Postgres / Supabase
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/allycircle

# Optional: Google login (never Calendar) — add in Google Cloud, then paste here
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: email sending. Without this, mail is stored in /dev/inbox
# RESEND_API_KEY=

# Never commit real values. Do not paste secrets into chat.
